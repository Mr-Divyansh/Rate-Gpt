# Server
PORT=3000
NODE_ENV=development

# Public Web3Forms form access key. VITE_ variables are bundled into browser code.
# Web3Forms access keys are public form identifiers, not account passwords.
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# Optional server-side Web3Forms proxy. Requires a Pro plan and server-IP safelisting.
WEB3FORMS_ACCESS_KEY=

# WeatherAPI browser key. VITE_ variables are bundled into public browser code;
# this value is public and must never be treated as a secret.
VITE_WEATHERAPI_KEY=

# Government of India OGD / AGMARKNET API
DATA_GOV_API_KEY=your_data_gov_in_api_key_here
DATA_GOV_API_BASE_URL=https://api.data.gov.in/resource
DATA_GOV_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
