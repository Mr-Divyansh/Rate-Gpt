# Server
PORT=3000
NODE_ENV=development

# Database: omit DATABASE_URL for local SQLite.
# For production, set DATABASE_URL to a pooled PostgreSQL connection string.
# Vercel Postgres's standard POSTGRES_URL is also supported as a fallback.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Government of India OGD / AGMARKNET API
DATA_GOV_API_KEY=your_data_gov_in_api_key_here
DATA_GOV_API_BASE_URL=https://api.data.gov.in/resource
DATA_GOV_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# Required only to enable protected admin synchronization
ADMIN_SYNC_KEY=replace_with_a_long_random_secret
