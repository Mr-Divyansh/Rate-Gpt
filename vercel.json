{
  "functions": {
    "api/index.ts": {
      "maxDuration": 300,
      "regions": ["bom1"]
    }
  },
  "redirects": [
    { "source": "/app", "destination": "/mandi-prices.html", "permanent": true },
    {
      "source": "/app/:path*",
      "destination": "/mandi-prices.html",
      "permanent": true
    },
    {
      "source": "/market-price",
      "destination": "/mandi-prices.html",
      "permanent": true
    },
    {
      "source": "/market-price/:path*",
      "destination": "/mandi-prices.html",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.ts" }
  ]
}
